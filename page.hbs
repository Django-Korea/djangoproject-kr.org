{{!< default}}

{{#post}}
<article>
  <div class="post-header">
    <h1>{{title}}</h1>
  </div>

  <div class="post-content content-area single">
    {{#if feature_image}}
      <figure>
        <img src="{{feature_image}}" alt="{{title}}">
      </figure>
    {{/if}}
    {{content}}
  </div>
</article>
{{/post}}
