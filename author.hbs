{{!< default}}

<div class="author-header">
  {{#if primary_author.profile_image}}
    <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}">
  {{/if}}
  <h1>{{primary_author.name}}</h1>
  {{#if primary_author.bio}}
    <p style="color: #666; max-width: 600px; margin: 0 auto;">{{primary_author.bio}}</p>
  {{/if}}
</div>

<div class="content-area">
  <main>
    {{#foreach posts}}
      {{> post-card}}
    {{/foreach}}

    {{> pagination}}
  </main>

  {{> sidebar}}
</div>
