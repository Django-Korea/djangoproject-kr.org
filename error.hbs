{{!< default}}

<div class="content-area single" style="text-align: center; padding: 80px 24px;">
  <h1 style="font-size: 72px; color: var(--django-green); margin-bottom: 16px;">{{statusCode}}</h1>
  <p style="font-size: 18px; color: #666;">{{message}}</p>
  <a href="{{@site.url}}" style="display: inline-block; margin-top: 24px; background: var(--django-green-dark); color: white; padding: 12px 24px; border-radius: 6px;">홈으로</a>
</div>
