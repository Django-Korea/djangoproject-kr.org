<header class="site-header">
  <div class="header-inner">
    <a href="{{@site.url}}" class="site-logo">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}">
      {{/if}}
      {{@site.title}}
    </a>
    <nav>
      <ul class="site-nav">
        {{navigation}}
      </ul>
    </nav>
  </div>
</header>
