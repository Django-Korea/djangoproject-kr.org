{{#if pagination}}
  <nav class="pagination">
    {{#if pagination.prev}}
      <a href="{{pagination.prev}}">&larr; 이전</a>
    {{/if}}
    <span style="color: #999;">Page {{pagination.page}} of {{pagination.pages}}</span>
    {{#if pagination.next}}
      <a href="{{pagination.next}}">다음 &rarr;</a>
    {{/if}}
  </nav>
{{/if}}
